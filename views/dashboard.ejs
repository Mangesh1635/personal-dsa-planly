<% function fm(m){const h=Math.floor(m/60),x=m%60;return h?`${h}h ${x?x+'m':''}`:`${m}m`} function fs(s){const h=Math.floor(s/3600),m=Math.floor(s%3600/60);return `${h}h ${m}m`} %>
<!doctype html><html><head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">

<title>DOD Task Manager</title>

<link rel="stylesheet" href="/css/style.css">

<!-- PWA -->
<link rel="manifest" href="/manifest.json">
<meta name="theme-color" content="#000000">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black">
<meta name="apple-mobile-web-app-title" content="Planly">
</head><body><%- include('partials/header') %><main class="container"><section class="hero"><div><span class="eyebrow">PERSONAL PLANNER</span><h1>Stay on top of your plan.</h1><p>Sprint → Day → Task, with a timer and persistent progress for every task.</p></div></section><section class="stats"><div><span>Overall progress</span><strong><%= stats.total?Math.round(stats.completed/stats.total*100):0 %>%</strong><small><%= stats.completed %> / <%= stats.total %> tasks</small></div><div><span>Time spent</span><strong id="totalSpent"><%= fs(stats.totalSpent) %></strong><small>of <%= Math.round(stats.totalEstimated/60) %>h estimated</small></div><div><span>In progress</span><strong><%= stats.inProgress %></strong><small>active tasks</small></div><div><span>Not completed</span><strong><%= stats.notStarted %></strong><small>remaining</small></div></section><nav class="sprints"><% sprints.forEach(s=>{ %><a class="sprint-tab <%= s===sprint?'active':'' %>" href="/?sprint=<%=s%>">Sprint <%=s%></a><% }) %></nav><section class="toolbar"><div><h2>Sprint <%=sprint%></h2><p>Timer and status are saved in MongoDB.</p></div><div class="filters"><button class="filter active" data-filter="all">All</button><button class="filter" data-filter="not_started">Not started</button><button class="filter" data-filter="in_progress">In progress</button><button class="filter" data-filter="completed">Completed</button></div></section><section><% const grouped={}; tasks.forEach(t=>(grouped[t.day]??=[]).push(t)); Object.keys(grouped).sort((a,b)=>a-b).forEach(day=>{const a=grouped[day],done=a.filter(t=>t.status==='completed').length,mins=a.reduce((s,t)=>s+t.estimatedMinutes,0); %><details class="day" <%=day==1?'open':''%>><summary><div class="day-title"><span class="chevron">›</span><b>Day <%=day%></b><span class="day-progress"><%=done%>/<%=a.length%> complete</span></div><div class="day-meta"><span>Est. <%=fm(mins)%></span><span><%=Math.round(done/a.length*100)%>%</span></div></summary><div class="task-list"><% a.forEach(t=>{ %><article class="task-card" data-status="<%=t.status%>"><button class="status-dot <%=t.status%>" onclick="cycleStatus('<%=t._id%>')"></button><div class="task-main"><div class="task-title"><%=t.title%></div><div class="task-meta"><span>Est. <%=fm(t.estimatedMinutes)%></span><span class="status-label"><%=t.status.replace('_',' ')%></span></div></div><button class="star <%=t.favorite?'liked':''%>" onclick="favoriteTask('<%=t._id%>',this)"><%=t.favorite?'★':'☆'%></button><div class="timer"><strong class="clock" data-id="<%=t._id%>" data-seconds="<%=t.displaySeconds%>" data-running="<%=t.isTimerRunning%>" data-started="<%=t.isTimerRunning?Date.now():''%>">00:00:00</strong><button class="timer-btn" onclick="toggleTimer('<%=t._id%>',this)"><%=t.isTimerRunning?'Pause':'Start'%></button><button class="reset-btn" onclick="resetTimer('<%=t._id%>')">↺</button></div></article><% }) %></div></details><%})%></section></main><script src="/js/app.js"></script></body></html>
